rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /replays/{replayId} {
      // Anyone can read a shared replay.
      allow read: if true;

      // Anyone can upload, but:
      //  - the doc may only contain the listed keys (bytes/upload meta plus
      //    optional summary fields denormalized for the recent-replays list)
      //  - bytes must be under 1 MiB (well under Firestore's 1,048,576-byte
      //    document hard limit) so the rest of the doc fits the limit too
      allow create: if request.resource.data.keys().hasOnly([
                       'bytes', 'uploadedAt', 'fileName',
                       'player', 'map', 'recordedAt', 'durationMs',
                       'totalDamage', 'avgDps', 'damageEvents', 'kills',
                       'entitiesSeen', 'handledPackets', 'packetCount',
                       'mvpRecords'
                     ])
                    && request.resource.data.bytes is bytes
                    && request.resource.data.bytes.size() < 1024 * 1024
                    && request.resource.data.fileName is string
                    && request.resource.data.fileName.size() < 200
                    && (!('mvpRecords' in request.resource.data)
                        || request.resource.data.mvpRecords.size() <= 250);

      // Replays are immutable and never expire by user action.
      allow update, delete: if false;
    }

    // RETIRED, kept on purpose: the in-app suggestions board was replaced by
    // the unified tracker at issues.latam-tools.com.br and the real suggestions
    // were migrated there. Both this block and the collection stay — deleting
    // the block would not delete the documents, it would just leave the
    // collection with no explicit rule. Reads stay open so the archived history
    // remains readable; writes are closed so no stale cached client can still
    // post or vote.
    match /suggestions/{suggestionId} {
      // Anyone can read the archived suggestion list.
      allow read: if true;

      // Closed — the live board is issues.latam-tools.com.br.
      allow create, update: if false;

      allow delete: if false;
    }
  }
}
