rules_version = '2';

// RETIRED on 28/08/2026. Replays live in Cloudflare D1 + R2 now, served by
// worker/index.ts — see README. This file is kept, and the collections with it,
// for two reasons: the data is the rollback target if the migration has to be
// undone, and deleting a rules block would not delete the documents, it would
// just leave the collection with no explicit rule.
//
// NOT SELF-APPLYING. Editing this file changes nothing until someone runs
//   firebase deploy --only firestore:rules --project ragreplaystats
// Until that runs, the previous rules are still live and still accept uploads.
service cloud.firestore {
  match /databases/{database}/documents {
    match /replays/{replayId} {
      // Reads stay open so the archived data remains readable and the migration
      // tool (which uses the Admin SDK and bypasses rules anyway) has a
      // human-checkable counterpart.
      allow read: if true;

      // Closed. Uploads go to POST /api/replays on Cloudflare. This is what
      // stops a browser running a cached copy of the old bundle from writing
      // replays into a collection nothing reads any more — they would look like
      // successful shares to the user and then be invisible on the live site.
      allow create, update, delete: if false;
    }

    // RETIRED earlier: the in-app suggestions board was replaced by the unified
    // tracker at issues.latam-tools.com.br and the real suggestions migrated
    // there. Reads stay open so the archived history remains readable.
    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
